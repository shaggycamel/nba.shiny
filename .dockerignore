# Version control / editor
.git
.gitignore
.Rproj.user
.DS_Store

# Data sources (the league tarball already carries data/)
dash_league/data/
dash_league/data-raw/

# Dev / tests / docs / host-only tooling not needed to build or run the images
dash_league/dev/
dash_league/tests/
dash_league/man/
docs/
deploy/
e2e/

# Host secrets and local admin scripts — never sent to the daemon
.profile
scripts/

# Generated docker artifacts (must not shadow the league tarball)
docker/*.tar.gz
docker/renv.lock

# renv working dirs (keep renv/activate.R and root renv.lock)
renv/staging/
renv/local/
renv/cellar/
renv/lock/
renv/python/
renv/sandbox/

# Build artifacts
*.Rproj
*.Rhistory
*.Rdata
