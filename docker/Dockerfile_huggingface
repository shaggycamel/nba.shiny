FROM shaggycamel/nba.shiny:latest

EXPOSE 7860

USER root
RUN useradd -m -u 1000 hfuser || true

USER 1000

CMD ["R", "-e", "options('shiny.port'=7860, shiny.host='0.0.0.0'); library(nba.shiny); nba.shiny::run_app()"]

