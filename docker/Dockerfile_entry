FROM scs.nba.fty.league_dash_base:latest

# The entry point app. core is already installed in the base image.
COPY entry /tmp/entry
RUN R -e 'install.packages("/tmp/entry", repos = NULL, type = "source")' \
    && rm -rf /tmp/entry

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -f http://localhost:3838/ || exit 1

EXPOSE 3838
USER rstudio
CMD R -e "options(shiny.port=3838, shiny.host='0.0.0.0'); library(entry); entry::run_app()"
