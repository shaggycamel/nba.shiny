FROM nba.shiny_base:latest

# The entry point app. nba.shiny.core is already installed in the base image.
COPY packages/nba.shiny.entry /tmp/nba.shiny.entry
RUN R -e 'install.packages("/tmp/nba.shiny.entry", repos = NULL, type = "source")' \
    && rm -rf /tmp/nba.shiny.entry

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
    CMD curl -f http://localhost:3838/ || exit 1

EXPOSE 3838
USER rstudio
CMD R -e "options(shiny.port=3838, shiny.host='0.0.0.0'); nba.shiny.entry::run_app()"
